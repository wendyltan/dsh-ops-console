{
  "name": "dsh-ops-console",
  "version": "0.4.0",
  "description": "DeepSeek Harness 的浏览器/手机运行帮助台：用用户语言说明状态、引导检查问题并生成脱敏诊断报告。",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wendyltan/dsh-ops-console.git"
  },
  "homepage": "https://github.com/wendyltan/dsh-ops-console#readme",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "ops",
    "console",
    "diagnostics",
    "tailscale",
    "remote-access"
  ],
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "files": [
    "lib",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ]
}
