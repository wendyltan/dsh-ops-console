{
  "name": "dsh-ops-console",
  "version": "0.5.1",
  "description": "DeepSeek Harness 的远程访问控制台：安全开启/关闭 Tailscale 远程入口，并管理 Harness 接受的访问地址与运维令牌。",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wendyltan/dsh-ops-console.git"
  },
  "homepage": "https://github.com/wendyltan/dsh-ops-console#readme",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "ops",
    "console",
    "tailscale",
    "remote-access"
  ],
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    },
    "guardian": {
      "protocolVersion": 1,
      "healthPath": "/dsh-ops/status",
      "snapshotLinkedBundle": true,
      "profileFiles": []
    }
  },
  "files": [
    "lib",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ]
}
