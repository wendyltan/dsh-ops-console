{
  "name": "dsh-ops-console",
  "version": "0.7.0",
  "description": "DeepSeek Harness 的简洁远程访问面板：管理 Tailscale 入口、可信地址与本地生成的访问二维码。",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wendyltan/dsh-ops-console.git"
  },
  "homepage": "https://github.com/wendyltan/dsh-ops-console#readme",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "qrcode-generator": "2.0.4"
  },
  "scripts": {
    "test": "node scripts/verify.mjs",
    "prepublishOnly": "node scripts/verify.mjs"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "ops",
    "console",
    "tailscale",
    "remote-access"
  ],
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    },
    "guardian": {
      "protocolVersion": 1,
      "healthPath": "/dsh-ops/status",
      "snapshotLinkedBundle": true,
      "profileFiles": []
    }
  },
  "files": [
    "lib",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ]
}
